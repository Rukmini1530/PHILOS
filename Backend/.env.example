# Copy to .env for local use and replace every placeholder before startup.
# DATABASE_URL must point to the intended PostgreSQL or SQLite database.
# For Docker Compose, match the database username/password/database below.
DATABASE_URL=postgresql://astropixel:REPLACE_WITH_LOCAL_DB_PASSWORD@db:5432/nasa_explorer

# Compose passes this to the Postgres container. Match it to DATABASE_URL above.
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD

# Generate a unique strong value, for example with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional runtime settings (non-secret).
DEBUG=False
LOG_LEVEL=INFO

# Optional Cloudflare R2 / S3 settings. Supply credentials only if enabled.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=auto
S3_ENDPOINT_URL=
R2_PUBLIC_URL=

# Optional separate bucket for private user tiles and previews.
# The operator must first verify this bucket has public access disabled.
# Cloud uploads for private datasets remain disabled unless confirmation is true.
PRIVATE_S3_BUCKET_NAME=
PRIVATE_S3_BUCKET_PRIVATE_ACCESS_CONFIRMED=False
